# Origin API — environment reference
#
# This file is a REFERENCE, not a dotenv that gets loaded. Settings are read from
# the real process environment only, so a stray local file can never make the
# test suite start calling a live model. Copy the lines you need into your shell.
#
# PowerShell:
#   gcloud auth application-default login
#   $env:ORIGIN_GCP_PROJECT = "project-5e761e8c-65aa-4033-8cb"
#   py -3 -m uvicorn origin.main:app --reload --port 8000
#
# There is no API-key variable. Organisation policy forbids API keys; the only
# supported credential is Application Default Credentials (local: the command
# above; Cloud Run: the service account, which needs roles/aiplatform.user).

# --- Vertex AI ---------------------------------------------------------------
# Empty project => no model client is built and every call takes its
# deterministic fallback. The whole demo loop still completes.
ORIGIN_GCP_PROJECT=project-5e761e8c-65aa-4033-8cb

# "global" is verified working for the selected Vertex model.
ORIGIN_VERTEX_LOCATION=global

# Flash tier only. Never Pro.
ORIGIN_GEMINI_MODEL=gemini-3.7-flash

# In-process guard against a runaway loop. 0 disables the cap.
ORIGIN_LLM_DAILY_CALL_CAP=200

# Also honoured, if you already have them set for the Google SDK:
#   GOOGLE_CLOUD_PROJECT, GCLOUD_PROJECT   -> project
#   GOOGLE_CLOUD_LOCATION                  -> location

# --- storage -----------------------------------------------------------------
# json = local file at apps/api/data/origin.json (default, no cloud needed)
# firestore = durable, multi-instance Cloud Run state
ORIGIN_STORE=json
ORIGIN_FIRESTORE_PREFIX=origin
# Evidence bucket. Empty => local files under apps/api/data/evidence/
ORIGIN_BUCKET=

# --- background agent -------------------------------------------------------
# inline = immediate local execution; tasks = durable Cloud Tasks dispatch.
ORIGIN_AGENT_DISPATCH=inline
ORIGIN_TASKS_LOCATION=europe-west1
ORIGIN_TASKS_QUEUE=origin-agent
# Required in tasks mode; the public HTTPS URL of origin-api.
ORIGIN_API_BASE_URL=
# Cloud deployment: OIDC identity attached to Cloud Tasks requests.
ORIGIN_TASK_SERVICE_ACCOUNT=
# Require and verify that identity at the worker route.
ORIGIN_REQUIRE_WORKER_OIDC=false
# Required in tasks mode. Store outside Git; Cloud Tasks sends it as a header.
ORIGIN_INTERNAL_TOKEN=

# Optional partner-system webhook. GCS partner-inbox delivery is automatically
# enabled whenever ORIGIN_BUCKET is set.
ORIGIN_PARTNER_WEBHOOK_URL=
ORIGIN_PARTNER_WEBHOOK_SECRET=
# Per-file upload guard for public demo endpoints (10 MB by default).
ORIGIN_MAX_UPLOAD_BYTES=10000000

# --- auth --------------------------------------------------------------------
# Set to verify Firebase ID tokens. Empty => demo bearer tokens only.
ORIGIN_FIREBASE_PROJECT_ID=
# Turn off before anything resembling production.
ORIGIN_DEMO_TOKENS=true
# Seed the isolated Riverside Farms judge tenant.
ORIGIN_SEED_DEMO=true
# Protect a public shared judge tenant from destructive account erasure.
ORIGIN_SHARED_DEMO=false

# --- web ---------------------------------------------------------------------
ORIGIN_CORS_ORIGINS=http://localhost:3000
